{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-openai-codex-auth", "./plugins/asana-comment-schema-fix.ts"],
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "ask",
    "write": "ask",
    "bash": "ask",
    "doom_loop": "deny",
    "digitalocean_*": "allow",
    "digitalocean_*droplet*": "ask",
    "digitalocean_db_cluster_create*": "ask",
    "digitalocean_db_cluster_delete*": "ask",
    "digitalocean_db_cluster_update*": "ask",
    "digitalocean_db_cluster_upgrade*": "ask",
    "digitalocean_db_cluster_start*": "ask",
    "digitalocean_db_cluster_stop*": "ask",
    "digitalocean_db_cluster_set*": "ask",
    "digitalocean_db_cluster_resize": "ask",
    "digitalocean_volume_*": "ask",
    "digitalocean_reserved_ip_*": "ask",
    "digitalocean_image_action_*": "ask",
    "digitalocean_*_create*": "ask",
    "digitalocean_*_update*": "ask",
    "digitalocean_*_delete*": "ask",
    "digitalocean_*_add*": "ask",
    "digitalocean_*_remove*": "ask",
    "digitalocean_*_edit": "ask",
    "digitalocean_*_tag": "ask"
  },
  "mcp": {
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": false
    },
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": false
    },
    "asana": {
      "type": "remote",
      "url": "https://mcp.asana.com/v2/mcp",
      "enabled": false,
      "oauth": {
        "clientId": "{env:ASANA_CLIENT_ID}",
        "clientSecret": "{env:ASANA_CLIENT_SECRET}",
        "redirectUri": "http://localhost:3334/oauth/callback"
      }
    },
    "home-assistant": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "exec \"$HOME/.config/opencode/bin/ha-mcp\""
      ],
      "enabled": false,
      "timeout": 30000
    },
    "digitalocean": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "exec \"$HOME/.config/opencode/bin/do-mcp\""
      ],
      "enabled": false,
      "timeout": 60000
    },
    "fusion360": {
      "type": "local",
      "command": [
        "/opt/homebrew/bin/uvx",
        "fusion360-mcp-server",
        "--mode",
        "socket"
      ],
      "enabled": false
    },
    "netbird": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "exec \"$HOME/.config/opencode/bin/mcp-netbird\""
      ],
      "enabled": false
    }
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "devstral": {
          "name": "Devstral (local)",
          "limit": {
            "context": 128000,
            "output": 65536
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          }
        }
      }
    }
  }
}

#!/bin/bash

# Tmux session setup for Tapify project
# Cross-platform: Works on both macOS and Linux

set -e

TMUX_CONFIG="${HOME}/.tmux.conf"
tmuxc() {
    tmux -f "$TMUX_CONFIG" "$@"
}

# Detect OS and set base directory
if [[ "$OSTYPE" == "darwin"* ]]; then
    # macOS
    BASE_DIR="/Users/gzg/Projects/Websites/tapify"
    STATION_DEPLOY_DIR="$BASE_DIR/tapify-station-deployment"
    MQTT_CONTAINER="mqtt_broker"
else
    # Linux (Omarchy)
    BASE_DIR="/home/gzg/Projects/tapify"
    MQTT_CONTAINER="mqtt_broker_dev"
fi

SESSION_NAME="Tapify"

# Start Docker containers before creating session
echo "Starting Docker containers..."
if [[ "$OSTYPE" == "darwin"* ]]; then
    (
        cd "$STATION_DEPLOY_DIR"
        docker compose up -d mqtt
    )

    # Verify MQTT broker is healthy by checking recent logs.
    attempts=0
    max_attempts=6
    expected_logs=(
        "Config loaded from /mosquitto/config/mosquitto.conf."
        "Opening ipv4 listen socket on port 1883."
        "Opening websockets listen socket on port 9001."
        "mosquitto version"
    )

    until (( attempts >= max_attempts )); do
        logs="$(docker logs --tail 20 "$MQTT_CONTAINER" 2>&1 || true)"
        healthy=true

        for expected in "${expected_logs[@]}"; do
            if [[ "$logs" != *"$expected"* ]]; then
                healthy=false
                break
            fi
        done

        if [[ "$healthy" == true ]]; then
            echo "MQTT broker is healthy"
            break
        fi

        attempts=$((attempts + 1))
        sleep 2
    done

    if (( attempts >= max_attempts )); then
        echo "Warning: MQTT broker health check did not match expected logs yet"
        docker logs --tail 20 "$MQTT_CONTAINER" || true
    fi

    docker start tapify-dev-mysql 2>/dev/null || echo "Note: tapify-dev-mysql may already be running or not found"
else
    docker start "$MQTT_CONTAINER" tapify-dev-mysql 2>/dev/null || echo "Note: Containers may already be running or not found"
fi

# Check if session already exists
if tmuxc has-session -t "$SESSION_NAME" 2>/dev/null; then
    echo "Session '$SESSION_NAME' already exists. Attaching..."
    tmuxc attach-session -t "$SESSION_NAME"
    exit 0
fi

# Create new session (first pane is automatically pane 1)
tmuxc new-session -d -s "$SESSION_NAME" -c "$BASE_DIR"

# ============================================
# Window 1: Development (dev)
# Layout: Left (nvim) | Right (opencode top, terminal bottom 5%)
# ============================================
tmuxc rename-window -t "$SESSION_NAME:1" "dev"

# Split to create left and right columns: pane 1 (left), pane 2 (right)
tmuxc split-window -h -t "$SESSION_NAME:1.1" -c "$BASE_DIR"

# Split right pane vertically: pane 2 (top), pane 3 (bottom)
tmuxc split-window -v -t "$SESSION_NAME:1.2" -c "$BASE_DIR"

# Send commands to specific panes
tmuxc send-keys -t "$SESSION_NAME:1.1" "cd $BASE_DIR && nvim" C-m
tmuxc send-keys -t "$SESSION_NAME:1.2" "cd $BASE_DIR && opencode" C-m

# ============================================
# Window 2: Services
# Layout: Left column (2 panes: api, station) | Right column (3 panes: mobile, dashboard, tap-ui)
#
# Right column order from top to bottom:
# - mobile app (needs more space)
# - dashboard
# - tap-ui
# ============================================
tmuxc new-window -t "$SESSION_NAME:2" -n "services" -c "$BASE_DIR"

# Step 1: Split horizontally to create left and right columns
# Result: pane 1 (left), pane 2 (right)
tmuxc split-window -h -t "$SESSION_NAME:2.1" -c "$BASE_DIR"

# Step 2: Build RIGHT column first (3 panes stacked vertically)
# Split pane 2 to create pane 3 below it
# Result: pane 1 (left), pane 2 (right top), pane 3 (right middle)
tmuxc split-window -v -t "$SESSION_NAME:2.2" -c "$BASE_DIR"

# Split pane 3 to create pane 4 below it
# Result: pane 1 (left), pane 2 (right top), pane 3 (right middle), pane 4 (right bottom)
tmuxc split-window -v -t "$SESSION_NAME:2.3" -c "$BASE_DIR"

# Step 3: Build LEFT column (2 panes)
# Split pane 1 to create pane 5 below it
# Result: pane 1 (left top), pane 5 (left bottom), pane 2 (right top), pane 3 (right middle), pane 4 (right bottom)
tmuxc split-window -v -t "$SESSION_NAME:2.1" -c "$BASE_DIR"

# Send directory and start commands
# Left column: pane 1 (tapify-api), pane 2 (tapify-station)
tmuxc send-keys -t "$SESSION_NAME:2.1" "cd $BASE_DIR/tapify-api && nvm use 22 && yarn start:dev" C-m
tmuxc send-keys -t "$SESSION_NAME:2.2" "cd $BASE_DIR/tapify-station && nvm use 22 && yarn start:dev" C-m

# Right column: pane 3 (tapify-mobile-app), pane 4 (tapify-dashboard), pane 5 (tapify-tap-ui)
tmuxc send-keys -t "$SESSION_NAME:2.3" "cd $BASE_DIR/tapify-mobile-app && nvm use 22 && yarn start --clear --dev-client" C-m
tmuxc send-keys -t "$SESSION_NAME:2.4" "cd $BASE_DIR/tapify-dashboard && nvm use 22 && yarn dev" C-m
tmuxc send-keys -t "$SESSION_NAME:2.5" "cd $BASE_DIR/tapify-tap-ui && nvm use 22 && yarn dev" C-m

# ============================================
# Window 3: Docker
# ============================================
tmuxc new-window -t "$SESSION_NAME:3" -n "docker" -c "$BASE_DIR"
tmuxc send-keys -t "$SESSION_NAME:3.1" "cd $BASE_DIR && lazydocker" C-m

# ============================================
# Window 4: Database
# ============================================
tmuxc new-window -t "$SESSION_NAME:4" -n "db" -c "$BASE_DIR"
tmuxc send-keys -t "$SESSION_NAME:4.1" "cd $BASE_DIR && lazysql" C-m

# Go back to window 1 and attach
tmuxc select-window -t "$SESSION_NAME:1"
tmuxc attach-session -t "$SESSION_NAME"

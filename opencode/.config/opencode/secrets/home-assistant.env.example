# This file is optional. The launcher reads the token from 1Password by default.
export HOMEASSISTANT_URL="https://homeassistant.example.com"
export HOMEASSISTANT_TOKEN_REF="op://Private/Home assistant/mcp-credential"
export OP_ACCOUNT="my.1password.com"

# To bypass 1Password explicitly, set the source to "environment" and provide
# the token through the process environment or here:
# export HOMEASSISTANT_TOKEN_SOURCE="environment"
# export HOMEASSISTANT_TOKEN="your_long_lived_access_token"

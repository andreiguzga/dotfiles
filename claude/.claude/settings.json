{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep"
    ],
    "ask": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/gzg/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "advisorModel": "opus",
  "theme": "dark",
  "agentPushNotifEnabled": true,
  "model": "opus"
}
